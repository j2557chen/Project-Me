<?xml version="1.0" encoding="utf-8"?>
<!-- The small icon shown in the status bar and on notifications: the app icon's stopwatch with
     a dumbbell inside, simplified so it reads at this size. Android draws notification icons
     in a single colour, using only the shape, so everything here is plain white. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- The stopwatch: its ring, the crown on top, and the button at the side. -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.8"
        android:fillColor="#00000000"
        android:pathData="M12,6.2 a7.6,7.6 0 1 1 0,15.2 a7.6,7.6 0 1 1 0,-15.2 z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M10.2,2 h3.6 v2 h-3.6 z M11.2,4 h1.6 v2.2 h-1.6 z" />
    <group
        android:pivotX="18.4"
        android:pivotY="7.2"
        android:rotation="45">
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M17.2,6.4 h2.4 v1.6 h-2.4 z" />
    </group>

    <!-- The dumbbell: a bar with a plate at each end. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M7.6,13.2 h8.8 v1.2 h-8.8 z M8.6,11 h1.7 v5.6 h-1.7 z M13.7,11 h1.7 v5.6 h-1.7 z" />
</vector>
